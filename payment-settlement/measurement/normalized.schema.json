{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Own request token usage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "run_id", "session_id", "event_id", "role", "model_label", "actual_model", "usage_scope", "input_tokens", "cached_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens", "provider_reported_cost_usd", "source_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"enum": ["codex", "openai", "anthropic"]},
    "run_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["implementer", "orchestrator", "worker", "reviewer", "prompt-author", "pm", "user-proxy", "test-designer"]},
    "model_label": {"type": "string", "minLength": 1},
    "actual_model": {"type": ["string", "null"]},
    "usage_scope": {"const": "own_request"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "provider_reported_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
